# Copy this file to `.env` and fill in real secrets. `.env` is gitignored.

# Spring profile to activate (loads application-local.properties)
SPRING_PROFILES_ACTIVE=local

# Database - change only if you use a different service name or DB
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/subscription_system
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# App secrets
JWT_SECRET=your_jwt_secret_here

# Stripe keys (regional)
STRIPE_API_KEY_SG=sk_test_sg
STRIPE_API_KEY_HK=sk_test_hk
STRIPE_API_KEY_MY=sk_test_my

# Stripe webhook and mock settings
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_SKIP_SIGNATURE_CHECK=true
STRIPE_MOCK_ENABLED=true
STRIPE_MOCK_BASE_URL=http://stripe-mock:12111

